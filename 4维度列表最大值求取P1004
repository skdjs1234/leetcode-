dp=[[[[0]*10 for i in range(10)]for i in range(10)]for i in range(10)]
grid=[[0]*10 for i in range(10)]
line=int(input())
while True:
    x,y,val= map(int,input().split())
    if x==0 and y==0 and val==0:
        break
    grid[y][x]=val
for j in range(1,10):
    for k in range(1,10):
        for l in range(1,10):
            for m in range(1,10):
                dp[j][k][l][m]=max(dp[j-1][k][l-1][m],dp[j-1][k][l][m-1],dp[j][k-1][l-1][m],dp[j][k-1][l][m-1])
                if j==l and k==m:
                
                    dp[j][k][l][m]+= grid[j][k]
                else:
                    dp[j][k][l][m]+=(grid[j][k] + grid[l][m])
print( dp[line][line][line][line])
